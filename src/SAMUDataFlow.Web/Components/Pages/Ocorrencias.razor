@page "/ocorrencias"
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using SAMUDataFlow.Domain.Comum
@using SAMUDataFlow.Domain.Entidades
@using SAMUDataFlow.Domain.Enums
@using SAMUDataFlow.Infrastructure.Persistencia
@inject SamuDbContext Db
@inject NavigationManager Navegacao
@inject AuthenticationStateProvider EstadoAutenticacao

<PageTitle>Ocorrências — SAMU DataFlow</PageTitle>

<section class="page occurrences-page">
    <header class="page-heading occurrences-heading">
        <div>
            <p class="eyebrow">CENTRAL DE ATENDIMENTO</p>
            <h1>Ocorrências</h1>
            <p class="page-subtitle">Consulte e acompanhe os atendimentos registrados.</p>
        </div>
        <div class="heading-actions">
            @if (PodeGerenciar)
            {
            <button class="button button-primary" type="button" @onclick="AbrirCadastro">
                <Icon Nome="square-plus" Tamanho="15" /> Adicionar ocorrência
            </button>
            }
            <a class="button button-secondary" href="importar">
                <Icon Nome="upload" Tamanho="15" /> Importar SQL
            </a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Erro))
    {
        <div class="notice notice-error" role="alert">@Erro</div>
    }
    @if (!string.IsNullOrWhiteSpace(Sucesso))
    {
        <div class="notice notice-success" role="status">@Sucesso</div>
    }

    <div class="occurrence-summary">
        <div><span class="summary-indicator indicator-all"></span><span>Total listado</span><strong>@Resultados.Count.ToString("N0", PtBr)</strong></div>
        <div><span class="summary-indicator indicator-active"></span><span>Em andamento</span><strong>@Resultados.Count(x => x.Status == StatusOcorrencia.EmAndamento).ToString("N0", PtBr)</strong></div>
        <div><span class="summary-indicator indicator-high"></span><span>Alta gravidade</span><strong>@Resultados.Count(x => x.Gravidade == Gravidade.Alta).ToString("N0", PtBr)</strong></div>
    </div>

    <div class="card filter-card">
        <div class="filter-topline">
            <div><h2 class="section-title">Filtrar ocorrências</h2><p class="muted">Combine os campos para localizar atendimentos.</p></div>
            <button class="text-button" type="button" @onclick="LimparFiltros">Limpar filtros</button>
        </div>
        <div class="filter-grid">
            <label class="filter-field filter-search"><span>Buscar</span>
                <input type="search" placeholder="Código, bairro ou distrito" @bind="Busca" @bind:event="oninput" @bind:after="AoAlterarFiltro" />
            </label>
            <label class="filter-field"><span>Tipo de agravo</span>
                <select @bind="FiltroAgravo" @bind:after="AoAlterarFiltro">
                    <option value="">Todos</option>
                    @foreach (var item in Enum.GetValues<TipoAgravo>()) { <option value="@item">@item.Rotulo()</option> }
                </select>
            </label>
            <label class="filter-field"><span>Gravidade</span>
                <select @bind="FiltroGravidade" @bind:after="AoAlterarFiltro">
                    <option value="">Todas</option>
                    @foreach (var item in Enum.GetValues<Gravidade>()) { <option value="@item">@item.Rotulo()</option> }
                </select>
            </label>
            <label class="filter-field"><span>Status</span>
                <select @bind="FiltroStatus" @bind:after="AoAlterarFiltro">
                    <option value="">Todos</option>
                    @foreach (var item in Enum.GetValues<StatusOcorrencia>()) { <option value="@item">@item.Rotulo()</option> }
                </select>
            </label>
            <label class="filter-field"><span>De</span><input type="date" @bind="DataInicio" @bind:after="AoAlterarFiltro" /></label>
            <label class="filter-field"><span>Até</span><input type="date" @bind="DataFim" @bind:after="AoAlterarFiltro" /></label>
        </div>
    </div>

    <div class="card table-card">
        <div class="table-heading">
            <div><h2 class="section-title">Registros</h2><p class="muted">@Resultados.Count.ToString("N0", PtBr) ocorrência(s) encontrada(s)</p></div>
            <span class="data-demo"><span></span> Registros no banco</span>
        </div>

        @if (Carregando)
        {
            <div class="table-empty">Carregando ocorrências…</div>
        }
        else if (Resultados.Count == 0)
        {
            <div class="table-empty"><strong>Nenhuma ocorrência encontrada</strong><span>Tente mudar os filtros. @if (PodeGerenciar) { <text><button class="text-link" type="button" @onclick="AbrirCadastro">Adicione uma ocorrência</button> ou </text> }<a class="text-link" href="importar">@(PodeGerenciar ? "importe um arquivo SQL" : "consulte a tela de importação")</a>.</span></div>
        }
        else
        {
            <div class="table-scroll">
                <table class="occurrence-table">
                    <thead>
                        <tr><th>Data e hora</th><th>Código</th><th>Localização</th><th>Tipo de agravo</th><th>Gravidade</th><th>Status</th><th>Resposta</th><th><span class="sr-only">Ações</span></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PaginaAtual)
                        {
                            <tr>
                                <td class="date-cell">@DataRecife(item.DataChamado).ToString("dd/MM/yyyy", PtBr)<small>@DataRecife(item.DataChamado).ToString("HH:mm", PtBr)</small></td>
                                <td class="code-cell">@item.CodigoExterno</td>
                                <td><strong>@item.Bairro</strong><small>@item.Distrito</small></td>
                                <td>@item.TipoAgravo.Rotulo()</td>
                                <td><span class="severity-badge @ClasseGravidade(item.Gravidade)">@item.Gravidade.Rotulo()</span></td>
                                <td><span class="status-badge @ClasseStatus(item.Status)"><span></span>@item.Status.Rotulo()</span></td>
                                <td>@(item.TempoRespostaMinutos.HasValue ? $"{item.TempoRespostaMinutos.Value:N1} min" : "—")</td>
                                <td><button class="row-action" type="button" aria-label="Ver ocorrência @item.CodigoExterno" @onclick="() => AbrirDetalhes(item)">Detalhes <span aria-hidden="true">→</span></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-row">
                <span class="muted">Exibindo @InicioVisivel–@FimVisivel de @Resultados.Count.ToString("N0", PtBr)</span>
                <div class="pagination-controls">
                    <button type="button" class="page-button" aria-label="Página anterior" disabled="@(Pagina <= 1)" @onclick="PaginaAnterior">‹</button>
                    <span>Página <strong>@Pagina</strong> de <strong>@TotalPaginas</strong></span>
                    <button type="button" class="page-button" aria-label="Próxima página" disabled="@(Pagina >= TotalPaginas)" @onclick="ProximaPagina">›</button>
                </div>
            </div>
        }
    </div>
</section>

@if (MostrarCadastro)
{
    <div class="modal-backdrop" role="presentation" @onclick="FecharCadastro">
        <section class="dialog-card detail-dialog" role="dialog" aria-modal="true" aria-labelledby="new-occurrence-title" @onclick:stopPropagation="true">
            <div class="dialog-heading">
                <div><p class="eyebrow">NOVO REGISTRO</p><h2 id="new-occurrence-title">Adicionar ocorrência</h2></div>
                <button type="button" class="dialog-close" aria-label="Fechar" @onclick="FecharCadastro">×</button>
            </div>
            <p class="muted">Preencha os dados operacionais. O registro será salvo no banco do projeto.</p>
            @if (!string.IsNullOrWhiteSpace(ErroCadastro)) { <div class="notice notice-error" role="alert">@ErroCadastro</div> }
            <div class="mapping-grid">
                <label class="filter-field"><span>Código da ocorrência *</span><input @bind="NovoCodigo" maxlength="100" required /></label>
                <label class="filter-field"><span>Data e hora do chamado *</span><input type="datetime-local" @bind="NovoDataChamado" @bind:format="yyyy-MM-ddTHH:mm" required /></label>
                <label class="filter-field"><span>Distrito / região *</span><input @bind="NovoDistrito" maxlength="100" required /></label>
                <label class="filter-field"><span>Bairro *</span><input @bind="NovoBairro" maxlength="100" required /></label>
                <label class="filter-field"><span>Tipo de agravo *</span>
                    <select @bind="NovoAgravo">
                        @foreach (var item in Enum.GetValues<TipoAgravo>()) { <option value="@item">@item.Rotulo()</option> }
                    </select>
                </label>
                <label class="filter-field"><span>Gravidade *</span>
                    <select @bind="NovaGravidade">
                        @foreach (var item in Enum.GetValues<Gravidade>()) { <option value="@item">@item.Rotulo()</option> }
                    </select>
                </label>
                <label class="filter-field"><span>Status *</span>
                    <select @bind="NovoStatus">
                        @foreach (var item in Enum.GetValues<StatusOcorrencia>()) { <option value="@item">@item.Rotulo()</option> }
                    </select>
                </label>
                <label class="filter-field"><span>Chegada da equipe (opcional)</span><input type="datetime-local" @bind="NovoDataChegada" @bind:format="yyyy-MM-ddTHH:mm" /></label>
                <label class="filter-field"><span>Desfecho</span>
                    <select @bind="NovoDesfecho"><option value="">Não informado</option>
                        @foreach (var item in Enum.GetValues<DesfechoOcorrencia>()) { <option value="@item">@item.Rotulo()</option> }
                    </select>
                </label>
                <label class="filter-field"><span>Hospital de destino</span><input @bind="NovoHospital" maxlength="200" /></label>
                <label class="filter-field"><span>Acompanhante</span><input @bind="NovoAcompanhante" maxlength="200" placeholder="Nome ou informação sobre acompanhante" /></label>
                <label class="filter-field filter-search"><span>Anotações dos paramédicos</span><textarea @bind="NovasAnotacoes" maxlength="4000" rows="3"></textarea></label>
                <label class="filter-field filter-search"><span>Observações extras</span><textarea @bind="NovasObservacoes" maxlength="4000" rows="3"></textarea></label>
            </div>
            <div class="dialog-actions">
                <button type="button" class="button button-secondary" @onclick="FecharCadastro">Cancelar</button>
                <button type="button" class="button button-primary" disabled="@SalvandoCadastro" @onclick="SalvarCadastroAsync">@(SalvandoCadastro ? "Salvando…" : "Salvar ocorrência")</button>
            </div>
        </section>
    </div>
}

@if (Selecionada is not null)
{
    <div class="modal-backdrop" role="presentation" @onclick="FecharDetalhes">
        <section class="dialog-card detail-dialog" role="dialog" aria-modal="true" aria-labelledby="detail-title" @onclick:stopPropagation="true">
            <div class="dialog-heading">
                <div><p class="eyebrow">DETALHES DO ATENDIMENTO</p><h2 id="detail-title">@Selecionada.CodigoExterno</h2></div>
                <button type="button" class="dialog-close" aria-label="Fechar" @onclick="FecharDetalhes">×</button>
            </div>
            <div class="detail-status"><span class="status-badge @ClasseStatus(Selecionada.Status)"><span></span>@Selecionada.Status.Rotulo()</span><span class="severity-badge @ClasseGravidade(Selecionada.Gravidade)">@Selecionada.Gravidade.Rotulo()</span></div>
            <div class="detail-grid">
                <div><span>Data do chamado</span><strong>@DataRecife(Selecionada.DataChamado).ToString("dd/MM/yyyy 'às' HH:mm", PtBr)</strong></div>
                <div><span>Tipo de agravo</span><strong>@Selecionada.TipoAgravo.Rotulo()</strong></div>
                <div><span>Bairro</span><strong>@Selecionada.Bairro</strong></div>
                <div><span>Distrito</span><strong>@Selecionada.Distrito</strong></div>
                <div><span>Chegada da equipe</span><strong>@(Selecionada.DataChegada.HasValue ? DataRecife(Selecionada.DataChegada.Value).ToString("dd/MM/yyyy 'às' HH:mm", PtBr) : "Aguardando")</strong></div>
                <div><span>Tempo de resposta</span><strong>@(Selecionada.TempoRespostaMinutos.HasValue ? $"{Selecionada.TempoRespostaMinutos.Value:N1} min" : "Ainda não concluído")</strong></div>
                <div><span>Coordenadas</span><strong>@Coordenadas(Selecionada)</strong></div>
                <div><span>Registrado em</span><strong>@DataRecife(Selecionada.RegistradoEm).ToString("dd/MM/yyyy 'às' HH:mm", PtBr)</strong></div>
                <div><span>Desfecho</span><strong>@(Selecionada.Desfecho?.Rotulo() ?? "Não informado")</strong></div>
                <div><span>Hospital de destino</span><strong>@(Selecionada.HospitalDestino ?? "Não informado")</strong></div>
                <div><span>Acompanhante</span><strong>@(Selecionada.Acompanhante ?? "Não informado")</strong></div>
                <div class="detail-wide"><span>Anotações dos paramédicos</span><strong>@(Selecionada.AnotacoesParamedicos ?? "Não informadas")</strong></div>
                <div class="detail-wide"><span>Observações extras</span><strong>@(Selecionada.ObservacoesExtras ?? "Não informadas")</strong></div>
            </div>
            @if (EditandoDetalhes)
            {
                <div class="mapping-grid">
                    <label class="filter-field"><span>Desfecho</span><select @bind="EdicaoDesfecho"><option value="">Não informado</option>@foreach (var item in Enum.GetValues<DesfechoOcorrencia>()) { <option value="@item">@item.Rotulo()</option> }</select></label>
                    <label class="filter-field"><span>Hospital de destino</span><input @bind="EdicaoHospital" maxlength="200" /></label>
                    <label class="filter-field"><span>Acompanhante</span><input @bind="EdicaoAcompanhante" maxlength="200" /></label>
                    <label class="filter-field filter-search"><span>Anotações dos paramédicos</span><textarea @bind="EdicaoAnotacoes" maxlength="4000" rows="3"></textarea></label>
                    <label class="filter-field filter-search"><span>Observações extras</span><textarea @bind="EdicaoObservacoes" maxlength="4000" rows="3"></textarea></label>
                </div>
                @if (!string.IsNullOrWhiteSpace(ErroEdicao)) { <div class="notice notice-error" role="alert">@ErroEdicao</div> }
                <div class="dialog-actions"><button type="button" class="button button-secondary" @onclick="CancelarEdicao">Cancelar</button><button type="button" class="button button-primary" disabled="@SalvandoEdicao" @onclick="SalvarEdicaoAsync">@(SalvandoEdicao ? "Salvando…" : "Salvar detalhes")</button></div>
            }
            else
            {
                <div class="dialog-actions">
                    @if (PodeGerenciar) { <button type="button" class="button button-primary" @onclick="IniciarEdicao">Editar detalhes</button> }
                    <button type="button" class="button button-secondary" @onclick="FecharDetalhes">Fechar</button>
                </div>
            }
        </section>
    </div>
}

@code {
    private static readonly CultureInfo PtBr = CultureInfo.GetCultureInfo("pt-BR");
    [SupplyParameterFromQuery(Name = "busca")] public string? BuscaInicial { get; set; }

    private List<Ocorrencia> Todas = [];
    private bool Carregando = true;
    private string? Erro;
    private string? Sucesso;
    private string Busca = "";
    private string FiltroAgravo = "";
    private string FiltroGravidade = "";
    private string FiltroStatus = "";
    private DateOnly? DataInicio;
    private DateOnly? DataFim;
    private const int TamanhoPagina = 15;
    private int Pagina = 1;
    private Ocorrencia? Selecionada;
    private bool MostrarCadastro;
    private bool PodeGerenciar;
    private bool EditandoDetalhes;
    private bool SalvandoEdicao;
    private string? ErroEdicao;
    private string EdicaoAnotacoes = "";
    private string EdicaoHospital = "";
    private string EdicaoObservacoes = "";
    private string EdicaoAcompanhante = "";
    private DesfechoOcorrencia? EdicaoDesfecho;
    private bool SalvandoCadastro;
    private string? ErroCadastro;
    private string NovoCodigo = "";
    private string NovoDistrito = "";
    private string NovoBairro = "";
    private DateTime NovoDataChamado = DateTime.Now;
    private DateTime? NovoDataChegada;
    private TipoAgravo NovoAgravo = TipoAgravo.Trauma;
    private Gravidade NovaGravidade = Gravidade.Media;
    private StatusOcorrencia NovoStatus = StatusOcorrencia.EmAndamento;
    private DesfechoOcorrencia? NovoDesfecho;
    private string NovoHospital = "";
    private string NovoAcompanhante = "";
    private string NovasAnotacoes = "";
    private string NovasObservacoes = "";

    private List<Ocorrencia> Resultados
    {
        get
        {
            IEnumerable<Ocorrencia> consulta = Todas;
            if (!string.IsNullOrWhiteSpace(Busca))
            {
                var termo = Busca.Trim();
                consulta = consulta.Where(x => x.CodigoExterno.Contains(termo, StringComparison.OrdinalIgnoreCase)
                    || x.Bairro.Contains(termo, StringComparison.OrdinalIgnoreCase)
                    || x.Distrito.Contains(termo, StringComparison.OrdinalIgnoreCase));
            }
            if (Enum.TryParse<TipoAgravo>(FiltroAgravo, out var tipo)) consulta = consulta.Where(x => x.TipoAgravo == tipo);
            if (Enum.TryParse<Gravidade>(FiltroGravidade, out var gravidade)) consulta = consulta.Where(x => x.Gravidade == gravidade);
            if (Enum.TryParse<StatusOcorrencia>(FiltroStatus, out var status)) consulta = consulta.Where(x => x.Status == status);
            if (DataInicio.HasValue)
            {
                var inicioUtc = DataInicio.Value.ToDateTime(TimeOnly.MinValue).AddHours(3);
                consulta = consulta.Where(x => x.DataChamado >= inicioUtc);
            }
            if (DataFim.HasValue)
            {
                var fimUtcExclusivo = DataFim.Value.AddDays(1).ToDateTime(TimeOnly.MinValue).AddHours(3);
                consulta = consulta.Where(x => x.DataChamado < fimUtcExclusivo);
            }
            return consulta.OrderByDescending(x => x.DataChamado).ToList();
        }
    }

    private List<Ocorrencia> PaginaAtual => Resultados.Skip((Pagina - 1) * TamanhoPagina).Take(TamanhoPagina).ToList();
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(Resultados.Count / (double)TamanhoPagina));
    private int InicioVisivel => Resultados.Count == 0 ? 0 : (Pagina - 1) * TamanhoPagina + 1;
    private int FimVisivel => Math.Min(Pagina * TamanhoPagina, Resultados.Count);

    protected override async Task OnInitializedAsync()
    {
        var estado = await EstadoAutenticacao.GetAuthenticationStateAsync();
        PodeGerenciar = estado.User.IsInRole(Usuario.AdministradorCompleto);
        Busca = BuscaInicial ?? "";
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        try
        {
            Todas = await Db.Ocorrencias.AsNoTracking().OrderByDescending(x => x.DataChamado).ToListAsync();
            Erro = null;
        }
        catch (Exception ex)
        {
            Erro = $"Não foi possível carregar as ocorrências: {ex.GetBaseException().Message}";
        }
        finally { Carregando = false; }
    }

    private void AoAlterarFiltro() => Pagina = 1;

    private void LimparFiltros()
    {
        Busca = "";
        FiltroAgravo = "";
        FiltroGravidade = "";
        FiltroStatus = "";
        DataInicio = null;
        DataFim = null;
        Pagina = 1;
        Sucesso = null;
        Navegacao.NavigateTo("/ocorrencias", replace: true);
    }

    private void PaginaAnterior() { if (Pagina > 1) Pagina--; }
    private void ProximaPagina() { if (Pagina < TotalPaginas) Pagina++; }
    private void AbrirDetalhes(Ocorrencia item) { Selecionada = item; EditandoDetalhes = false; }
    private void FecharDetalhes() { Selecionada = null; EditandoDetalhes = false; }

    private void IniciarEdicao()
    {
        if (!PodeGerenciar || Selecionada is null) return;
        EdicaoAnotacoes = Selecionada.AnotacoesParamedicos ?? "";
        EdicaoHospital = Selecionada.HospitalDestino ?? "";
        EdicaoObservacoes = Selecionada.ObservacoesExtras ?? "";
        EdicaoAcompanhante = Selecionada.Acompanhante ?? "";
        EdicaoDesfecho = Selecionada.Desfecho;
        ErroEdicao = null;
        EditandoDetalhes = true;
    }

    private void CancelarEdicao() { EditandoDetalhes = false; ErroEdicao = null; }

    private async Task SalvarEdicaoAsync()
    {
        if (!await AdministradorCompletoAtualAsync() || Selecionada is null || SalvandoEdicao)
        { ErroEdicao = "Seu perfil permite somente consulta."; return; }
        SalvandoEdicao = true;
        try
        {
            var atualizada = await Db.Ocorrencias.SingleAsync(x => x.Id == Selecionada.Id);
            atualizada.Atualizar(atualizada.DataChamado, atualizada.DataChegada, atualizada.Distrito, atualizada.Bairro,
                atualizada.TipoAgravo, atualizada.Gravidade, atualizada.Status, atualizada.Latitude, atualizada.Longitude,
                EdicaoAnotacoes, EdicaoDesfecho, EdicaoHospital, EdicaoObservacoes, EdicaoAcompanhante);
            await Db.SaveChangesAsync();
            var indice = Todas.FindIndex(x => x.Id == atualizada.Id);
            if (indice >= 0) Todas[indice] = atualizada;
            Selecionada = atualizada;
            EditandoDetalhes = false;
            Sucesso = $"Detalhes da ocorrência {atualizada.CodigoExterno} atualizados.";
        }
        catch (Exception ex) { ErroEdicao = ex.GetBaseException() is SAMUDataFlow.Domain.Excecoes.DominioException ? ex.GetBaseException().Message : "Não foi possível salvar os detalhes."; }
        finally { SalvandoEdicao = false; }
    }

    private void AbrirCadastro()
    {
        if (!PodeGerenciar) return;
        ErroCadastro = null;
        Sucesso = null;
        NovoCodigo = "";
        NovoDistrito = "";
        NovoBairro = "";
        NovoDataChamado = DateTime.Now;
        NovoDataChegada = null;
        NovoAgravo = TipoAgravo.Trauma;
        NovaGravidade = Gravidade.Media;
        NovoStatus = StatusOcorrencia.EmAndamento;
        NovoDesfecho = null;
        NovoHospital = NovoAcompanhante = NovasAnotacoes = NovasObservacoes = "";
        MostrarCadastro = true;
    }

    private void FecharCadastro() => MostrarCadastro = false;

    private async Task SalvarCadastroAsync()
    {
        if (!await AdministradorCompletoAtualAsync()) { ErroCadastro = "Seu perfil permite somente consulta."; return; }
        if (SalvandoCadastro) return;
        ErroCadastro = null;
        var codigo = NovoCodigo.Trim();
        if (string.IsNullOrWhiteSpace(codigo) || string.IsNullOrWhiteSpace(NovoDistrito) || string.IsNullOrWhiteSpace(NovoBairro))
        {
            ErroCadastro = "Preencha o código, o distrito e o bairro.";
            return;
        }

        SalvandoCadastro = true;
        try
        {
            if (await Db.Ocorrencias.AnyAsync(x => x.CodigoExterno == codigo))
            {
                ErroCadastro = "Já existe uma ocorrência com esse código.";
                return;
            }

            var chamadoUtc = DateTime.SpecifyKind(NovoDataChamado.AddHours(3), DateTimeKind.Utc);
            DateTime? chegadaUtc = NovoDataChegada.HasValue
                ? DateTime.SpecifyKind(NovoDataChegada.Value.AddHours(3), DateTimeKind.Utc)
                : null;
            var nova = Ocorrencia.Criar(codigo, chamadoUtc, chegadaUtc, NovoDistrito, NovoBairro, NovoAgravo, NovaGravidade, NovoStatus,
                anotacoesParamedicos: NovasAnotacoes, desfecho: NovoDesfecho, hospitalDestino: NovoHospital,
                observacoesExtras: NovasObservacoes, acompanhante: NovoAcompanhante);
            Db.Ocorrencias.Add(nova);
            await Db.SaveChangesAsync();
            Todas.Add(nova);
            Pagina = 1;
            MostrarCadastro = false;
            Sucesso = $"Ocorrência {nova.CodigoExterno} adicionada.";
        }
        catch (Exception ex)
        {
            ErroCadastro = ex.GetBaseException().Message.Contains("unique", StringComparison.OrdinalIgnoreCase)
                ? "Já existe uma ocorrência com esse código."
                : "Não foi possível salvar a ocorrência. Confira os campos e a conexão com o banco.";
        }
        finally { SalvandoCadastro = false; }
    }

    private async Task<bool> AdministradorCompletoAtualAsync()
    {
        var principal = (await EstadoAutenticacao.GetAuthenticationStateAsync()).User;
        var id = principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return principal.IsInRole(Usuario.AdministradorCompleto)
            && int.TryParse(id, out var usuarioId)
            && await Db.Usuarios.AsNoTracking().AnyAsync(x => x.Id == usuarioId && x.Papel == Usuario.AdministradorCompleto);
    }

    private static DateTime DataRecife(DateTime utc) => utc.AddHours(-3);
    private static string Coordenadas(Ocorrencia item) => item.Latitude.HasValue && item.Longitude.HasValue
        ? $"{item.Latitude.Value:F5}, {item.Longitude!.Value:F5}"
        : "Não informadas";
    private static string ClasseGravidade(Gravidade gravidade) => gravidade switch
    {
        Gravidade.Alta => "severity-high",
        Gravidade.Media => "severity-medium",
        _ => "severity-low"
    };
    private static string ClasseStatus(StatusOcorrencia status) => status == StatusOcorrencia.EmAndamento ? "status-active" : "status-complete";
}
