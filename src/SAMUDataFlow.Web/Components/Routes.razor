<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized><p role="alert">Sua sessão não está autenticada. <a href="/login">Entrar</a></p></NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <PageTitle>Página não encontrada — SAMU DataFlow</PageTitle>
            <PaginaEmConstrucao Titulo="Página não encontrada" Descricao="O endereço acessado não existe. Use o menu lateral para navegar." />
        </LayoutView>
    </NotFound>
</Router>
